{
  "schema": 1,
  "policy": "Every top-level source directory has one owned destination or retained role; nothing is deleted as part of layout migration.",
  "root_entries": [
    {"name": ".github", "role": "ci", "destination": ".github", "status": "retained"},
    {"name": "apps", "role": "applications", "destination": "apps", "status": "target"},
    {"name": "engine", "role": "shared engine", "destination": "engine", "status": "target"},
    {"name": "platform", "role": "platform adapters", "destination": "platform", "status": "target"},
    {"name": "shaders", "role": "owned shader pipeline", "destination": "shaders", "status": "target"},
    {"name": "tools", "role": "developer and fixture tools", "destination": "tools", "status": "target"},
    {"name": "tests", "role": "unit integration rendering and regression tests", "destination": "tests", "status": "target"},
    {"name": "third_party", "role": "pinned external dependencies", "destination": "third_party", "status": "target"},
    {"name": "cmake", "role": "build modules and historical root build", "destination": "cmake", "status": "target"},
    {"name": "docs", "role": "architecture research and status", "destination": "docs", "status": "target"},
    {"name": "content", "role": "preserved base runtime content", "destination": "content", "status": "retained"},
    {"name": "PlatformContent", "role": "preserved platform runtime content", "destination": "PlatformContent", "status": "retained"},

    {"name": "App", "role": "remaining player engine source", "destination": "engine by subsystem", "status": "migrating"},
    {"name": "Rendering", "role": "compatibility projects and unmoved renderer data", "destination": "engine/rendering and shaders", "status": "migrating"},

    {"name": "Android", "role": "preserved Android player source", "destination": "platform/android/client", "status": "queued"},
    {"name": "iOS", "role": "preserved iOS player source", "destination": "platform/ios/client", "status": "queued"},

    {"name": "Installer", "role": "historical installer source excluded from Player", "destination": "apps/installer/windows", "status": "queued"},


    {"name": "Library", "role": "mixed historical third-party source and binaries", "destination": "third_party by package", "status": "audit-required"}
  ],
  "migrated_entries": [
    {"name": "IncludeChecker", "destination": "tools/include_checker"},
    {"name": "SettingsComparisonTool", "destination": "tools/settings_comparison"},
    {"name": "SimulationTestUtility", "destination": "tests/simulation_regression"},
    {"name": "RefreshPolicies", "destination": "tools/refresh_policies"},
    {"name": "CoreScriptConverter2", "destination": "tools/core_script_converter"},
    {"name": "RobloxModelAnalyzer", "destination": "tools/model_analyzer"},
    {"name": "ScriptSigner", "destination": "tools/script_signer"},
    {"name": "RbxTestHooks", "destination": "tests/support/hooks"},
    {"name": "RCCService.PrepForUpload", "destination": "apps/services/rcc/deployment"},
    {"name": "RCCServiceArbiter.PrepForUpload", "destination": "apps/services/rcc_arbiter/deployment"},
    {"name": "RobloxStudio.PrepForUpload", "destination": "apps/studio/deployment"},
    {"name": "WindowsClient.PrepForUpload", "destination": "apps/player/windows/deployment"},
    {"name": "PrepAllForUpload", "destination": "tools/deployment/prep_all"},
    {"name": "App.UnitTest.Run", "destination": "tests/runners/datamodel"},
    {"name": "Base.UnitTest.Run", "destination": "tests/runners/core"},
    {"name": "RobloxTest.Run", "destination": "tests/runners/player"},
    {"name": "RobloxTest.MultiPlayerTest.Run", "destination": "tests/runners/multiplayer"},
    {"name": "RobloxTest.PhysicsPerfTest.Run", "destination": "tests/runners/physics_performance"},
    {"name": "RobloxTest.PhysicsTests.Run", "destination": "tests/runners/physics"},
    {"name": "App.UnitTest", "destination": "tests/unit/datamodel"},
    {"name": "App.UnitTest.Lib", "destination": "tests/support/datamodel"},
    {"name": "Base.UnitTest", "destination": "tests/unit/core"},
    {"name": "Base.UnitTest.Lib", "destination": "tests/support/core"},
    {"name": "RobloxTest", "destination": "tests/integration/player"},
    {"name": "Roblox.Test", "destination": "tests/integration/managed"},
    {"name": "RCCService.Test", "destination": "tests/services/rcc"},
    {"name": "RCCService.Thumb.Test", "destination": "tests/services/rcc_thumbnail"},
    {"name": "RobloxMobileTest", "destination": "tests/platform/mobile"},
    {"name": "Mac", "destination": "platform/macos/historical"},
    {"name": "RobloxMac", "destination": "apps/player/macos/source"},
    {"name": "MacClient.xcodeproj", "destination": "apps/player/macos/MacClient.xcodeproj"},
    {"name": "Win", "destination": "platform/windows/historical"},
    {"name": "WindowsClient", "destination": "apps/player/windows/source"},
    {"name": "RobloxHybrid", "destination": "platform/mobile/hybrid"},
    {"name": "XboxClient", "destination": "platform/xbox/client/source"},
    {"name": "Microsoft.Xbox.Samples.NetworkMesh", "destination": "third_party/samples/xbox_network_mesh"},
    {"name": "RobloxStudio", "destination": "apps/studio/source"},
    {"name": "StudioPlugins", "destination": "apps/studio/plugins/custom"},
    {"name": "BuiltInPlugins", "destination": "apps/studio/plugins/built_in"},
    {"name": "RCCService", "destination": "apps/services/rcc/source"},
    {"name": "Roblox.RccServiceArbiter", "destination": "apps/services/rcc_arbiter/source"},
    {"name": "PropertySheets", "destination": "cmake/historical/msbuild/PropertySheets"},
    {"name": "QTitanRibbon", "destination": "third_party/studio/qtitan_ribbon"},
    {"name": "boostlibs", "destination": "third_party/boost/build"},
    {"name": "fmod", "destination": "third_party/quarantined/fmod"},
    {"name": "Network", "destination": "engine/networking"},
    {"name": "ClientBase", "destination": "apps/player/shared/client_base"},
    {"name": "ClientShared", "destination": "apps/player/shared/client"},
    {"name": "GameChat", "destination": "engine/ui/chat"},
    {"name": "Base", "destination": "engine/core"},
    {"name": "CSG", "destination": "engine/geometry/csg"},
    {"name": "App.BulletPhysics", "destination": "third_party/bullet_historical"}
  ]
}
